{
  "name": "agent-teamroom",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop group chat for your AI agents.",
  "type": "module",
  "main": "dist-main/electron/main.js",
  "license": "MIT",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.electron.json && tsc --noEmit -p tsconfig.json && vite build",
    "start": "node scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run test && npm run build",
    "smoke:desktop": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.8.0",
    "playwright": "^1.58.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
